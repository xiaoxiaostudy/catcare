---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'map' | 'cats' | 'emergency' | 'about';
}

const { title, description = '学养猫，也给自家猫记一笔。养猫知识整理自兽医机构的公开资料，记录只存在你自己的浏览器里。', current } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title}｜健康养猫` : '健康养猫｜学养猫，也给自家猫记一笔';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="健康养猫" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1d22" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Long+Cang&display=swap" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <svg class="brand-paw" width="22" height="22" viewBox="-12 -12 24 24" aria-hidden="true"><ellipse cx="0" cy="4" rx="6.2" ry="5.2" /><circle cx="-6.6" cy="-3.6" r="2.7" /><circle cx="-2.3" cy="-8" r="2.7" /><circle cx="2.3" cy="-8" r="2.7" /><circle cx="6.6" cy="-3.6" r="2.7" /></svg>
          <span>健康养猫</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a href={base} aria-current={current === 'map' ? 'page' : undefined}>地图</a>
          <a href={`${base}cats/`} aria-current={current === 'cats' ? 'page' : undefined}>我的猫</a>
          <a href={`${base}about/`} aria-current={current === 'about' ? 'page' : undefined}>内容从哪来</a>
          <a class="nav-sos" href={`${base}emergency/`} aria-current={current === 'emergency' ? 'page' : undefined}>
            急症清单
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>这里的内容整理自国际兽医机构公开的资料，还没经兽医审核，不能代替兽医的诊断。猫的情况拿不准时，直接联系兽医。<a href={`${base}about/`}>内容从哪来</a></p>
      </div>
    </footer>
    <script>
      // 离线缓存（public/sw.js）只在正式构建里注册，开发时不缓存，免得改了看不到。
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`);
      }
      // 安卓和电脑上的 Chrome 会在能安装时发这个事件，先存下来，「我的猫」里的「添加到主屏幕」按钮要用
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        (window as any).__installPrompt = e;
        window.dispatchEvent(new Event('catcare:installable'));
      });
    </script>
  </body>
</html>
