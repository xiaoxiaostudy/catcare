---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../data/map';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const base = import.meta.env.BASE_URL;

const moduleIndex = MODULES.findIndex((m) => m.id === note.data.module);
const mod = MODULES[moduleIndex];

// 同一区域里已写好的笔记，按地图顺序排，用来做上一篇/下一篇
const written = new Set((await getCollection('notes')).map((n) => n.id));
const siblings = mod.topics.filter((t) => t.note && written.has(t.note));
const pos = siblings.findIndex((t) => t.note === note.id);
const prev = siblings[pos - 1];
const next = siblings[pos + 1];

const toc = headings.filter((h) => h.depth === 2).map((h) => ({ ...h, text: h.text.replace(/^\d+\.\s*/, '') }));
const date = note.data.date.toISOString().slice(0, 10);
---

<Base title={note.data.title} description={note.data.summary}>
  <article class="note wrap narrow">
    <nav class="crumbs" aria-label="位置">
      <a href={base}>地图</a>
      <span aria-hidden="true">/</span>
      <span>{String(moduleIndex + 1).padStart(2, '0')} {mod.name}</span>
    </nav>

    <h1 class="serif">{note.data.title}</h1>
    <p class="meta">
      <span class="pill status" data-status={note.data.status}>{note.data.status}</span>
      <span>{date} · @{note.data.author}</span>
    </p>

    <aside class="takeaway">
      <p class="takeaway-label">一句话结论</p>
      <p class="takeaway-text">{note.data.summary}</p>
    </aside>

    {toc.length > 0 && (
      <nav class="toc" aria-label="本篇目录">
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="上一篇和下一篇">
      {prev ? (
        <a class="pager-link" href={`${base}notes/${prev.note}/`}>
          <span class="eyebrow">← 上一篇</span>
          <span>{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="pager-link next" href={`${base}notes/${next.note}/`}>
          <span class="eyebrow">下一篇 →</span>
          <span>{next.title}</span>
        </a>
      ) : (
        <a class="pager-link next" href={base}>
          <span class="eyebrow">回到地图 →</span>
          <span>看看下一块要点亮哪里</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .note {
    padding-top: 28px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    margin: 10px 0 8px;
    font-size: clamp(28px, 5.5vw, 38px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .takeaway {
    margin: 24px 0;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .takeaway-label {
    margin: 0 0 4px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .takeaway-text {
    margin: 0;
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.75;
  }

  .toc {
    display: flex;
    gap: 8px;
    margin: 0 -16px 8px;
    padding: 0 16px 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .toc a {
    flex: none;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }

  .toc a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }

  .pager-link {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
  }

  .pager-link:hover {
    border-color: var(--accent);
  }

  /* 正文里按类型分节 */
  .prose :global(.note-section) {
    margin: 28px 0;
  }

  .prose :global(h2) {
    margin: 0 0 10px;
    font-size: 22px;
    scroll-margin-top: 72px;
  }

  .prose :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .prose :global(.kind-danger),
  .prose :global(.kind-todo),
  .prose :global(.kind-questions),
  .prose :global(.kind-myths) {
    padding: 18px 20px;
    border-radius: var(--radius);
  }

  .prose :global(.kind-danger) {
    border: 1.5px solid color-mix(in srgb, var(--danger) 45%, transparent);
    background: var(--danger-soft);
  }

  .prose :global(.kind-danger h2) {
    color: var(--danger);
  }

  .prose :global(.kind-danger h2)::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--danger-fill);
    color: #fff;
    font-size: 15px;
    vertical-align: 2px;
  }

  .prose :global(.kind-todo) {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .prose :global(.kind-todo h2)::before {
    content: '🏠 ';
  }

  .prose :global(.kind-myths) {
    background: var(--warn-soft);
  }

  .prose :global(.kind-myths h2) {
    color: var(--warn);
  }

  .prose :global(.kind-myths li::marker) {
    content: '✗  ';
    color: var(--warn);
    font-weight: 700;
  }

  .prose :global(.kind-questions) {
    background: var(--calm-soft);
  }

  .prose :global(.kind-questions h2) {
    color: var(--calm);
  }


  .prose :global(.kind-local) {
    color: var(--ink-2);
  }

  .prose :global(details.note-section) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .prose :global(details.note-section > summary) {
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
  }

  .prose :global(details.note-section > summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(details.note-section > summary h2) {
    display: inline;
    margin: 0;
    font-size: 18px;
  }

  .prose :global(details.note-section > summary)::after {
    content: '展开';
    float: right;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
  }

  .prose :global(details.note-section[open] > summary)::after {
    content: '收起';
  }

  .prose :global(details.note-section > :not(summary)) {
    margin-left: 20px;
    margin-right: 20px;
  }

  .prose :global(details.note-section[open]) {
    padding-bottom: 8px;
  }

  .prose :global(.kind-sources li) {
    font-size: 15px;
  }
</style>
