---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../data/map';
import BreathTimer from '../../components/tools/BreathTimer';
import BodyCondition from '../../components/tools/BodyCondition';
import LitterWatch from '../../components/tools/LitterWatch';
import SpotChange from '../../components/tools/SpotChange';
import BodyLanguage from '../../components/tools/BodyLanguage';
import '../../styles/cats.css';
import '../../styles/tools.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const base = import.meta.env.BASE_URL;

const moduleIndex = MODULES.findIndex((m) => m.id === note.data.module);
const mod = MODULES[moduleIndex];

// 同一区域里已写好的笔记，按地图顺序排，用来做上一篇/下一篇
const written = new Set((await getCollection('notes')).map((n) => n.id));
const siblings = mod.topics.filter((t) => t.note && written.has(t.note));
const pos = siblings.findIndex((t) => t.note === note.id);
const prev = siblings[pos - 1];
const next = siblings[pos + 1];

// 「存疑点」「我家猫」两节只给作者看，网页上不显示（见 rehype-note-sections），目录里也去掉
const toc = headings.filter((h) => h.depth === 2 && !/存疑点|我家猫/.test(h.text)).map((h) => ({ ...h, text: h.text.replace(/^\d+\.\s*/, '') }));
const date = note.data.date.toISOString().slice(0, 10);
const reviewed = note.data.status === '已审核';
---

<Base title={note.data.title} description={note.data.summary}>
  <article class="note wrap narrow">
    <nav class="crumbs" aria-label="位置">
      <a href={base}>地图</a>
      <span aria-hidden="true">/</span>
      <span>{String(moduleIndex + 1).padStart(2, '0')} {mod.name}</span>
    </nav>

    <h1 class="hand">{note.data.title}</h1>
    <p class="meta">
      <span class:list={['trust', { reviewed }]}>{reviewed ? '兽医审核过' : '整理自公开的兽医资料，还没经兽医审核'}</span>
      <span>更新于 {date}</span>
    </p>

    <aside class="takeaway">
      <p class="takeaway-label">一句话结论</p>
      <p class="takeaway-text">{note.data.summary}</p>
    </aside>

    {note.data.widget === 'breath-timer' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：现在就数一次</h2>
        <BreathTimer client:only="preact" />
      </section>
    )}

    {note.data.widget === 'heart-timer' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：数一次心跳</h2>
        <BreathTimer client:only="preact" kind="heart" />
      </section>
    )}

    {note.data.widget === 'spot-change' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：找出哪里不一样</h2>
        <SpotChange client:only="preact" base={base} />
      </section>
    )}

    {note.data.widget === 'body-language' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：它在说什么？</h2>
        <BodyLanguage client:only="preact" />
      </section>
    )}

    {note.data.widget === 'body-condition' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：它现在是几分？</h2>
        <BodyCondition client:only="preact" />
      </section>
    )}

    {note.data.widget === 'litter-watch' && (
      <section class="try-it" aria-labelledby="try-it">
        <h2 id="try-it" class="try-title">动手试试：哪只要马上去医院？</h2>
        <LitterWatch client:only="preact" emergencyHref={`${base}emergency/#blocked`} />
      </section>
    )}

    {toc.length > 0 && (
      <nav class="toc" aria-label="本篇目录">
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <section class="learn" data-note={note.id}>
      <button type="button" class="learn-btn" aria-pressed="false">
        <svg class="learn-paw" viewBox="-12 -12 24 24" aria-hidden="true">
          <ellipse cx="0" cy="4" rx="6.2" ry="5.2" /><circle cx="-6.6" cy="-3.6" r="2.7" /><circle cx="-2.3" cy="-8" r="2.7" /><circle cx="2.3" cy="-8" r="2.7" /><circle cx="6.6" cy="-3.6" r="2.7" />
        </svg>
        <span class="learn-label">我学会了这一篇</span>
      </button>
      <p class="learn-msg">
        <span class="learn-todo">点一下，首页三花猫的「{mod.name}」那块就会多上一点颜色。</span>
        <span class="learn-done">已记下。<a href={`${base}#${mod.id}`}>回地图看看你的三花猫</a>；再点一下按钮可以撤销。</span>
      </p>
    </section>

    <nav class="pager" aria-label="上一篇和下一篇">
      {prev ? (
        <a class="pager-link" href={`${base}notes/${prev.note}/`}>
          <span class="eyebrow">← 上一篇</span>
          <span>{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="pager-link next" href={`${base}notes/${next.note}/`}>
          <span class="eyebrow">下一篇 →</span>
          <span>{next.title}</span>
        </a>
      ) : (
        <a class="pager-link next" href={base}>
          <span class="eyebrow">回到地图</span>
          <span>看看下一块要点亮哪里</span>
        </a>
      )}
    </nav>
  </article>

  <script>
    import { loadLearned, setLearned } from '../../lib/learned';

    // 「我学会了这一篇」：记在这台设备的浏览器里，首页的三花猫按它填色
    const box = document.querySelector<HTMLElement>('.learn')!;
    const btn = box.querySelector<HTMLButtonElement>('.learn-btn')!;
    const note = box.dataset.note!;

    function show(on: boolean) {
      box.classList.toggle('on', on);
      btn.setAttribute('aria-pressed', String(on));
      btn.querySelector('.learn-label')!.textContent = on ? '已学会' : '我学会了这一篇';
    }

    show(loadLearned().has(note));
    btn.addEventListener('click', () => {
      const on = !loadLearned().has(note);
      if (setLearned(note, on)) show(on);
      else box.querySelector('.learn-msg')!.textContent = '这台设备的浏览器不允许保存（可能是无痕模式），学习进度记不下来。';
    });
  </script>
</Base>

<style>
  .note {
    padding-top: 28px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    margin: 12px 0 10px;
    font-size: clamp(38px, 7vw, 56px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .takeaway {
    margin: 24px 0;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .takeaway-label {
    margin: 0 0 4px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .takeaway-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.75;
  }

  .toc {
    display: flex;
    gap: 8px;
    margin: 0 -16px 8px;
    padding: 0 16px 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .toc a {
    flex: none;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }

  .toc a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .trust {
    padding: 0 10px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-2);
    line-height: 26px;
  }

  .trust.reviewed {
    background: color-mix(in srgb, var(--s-done) 18%, transparent);
    color: var(--ink);
  }

  .trust.reviewed::before {
    content: '✓ ';
    color: var(--s-done);
  }

  .learn {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin: 40px 0 0;
    padding: 24px 20px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    text-align: center;
  }

  .learn-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 22px 8px 16px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
  }

  .learn-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .learn-paw {
    width: 30px;
    height: 30px;
    transform: rotate(-12deg);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    transition: transform 0.25s;
  }

  .learn.on .learn-btn {
    border-color: var(--ginger);
    background: color-mix(in srgb, var(--ginger) 18%, var(--surface));
    color: var(--ink);
  }

  .learn.on .learn-paw {
    fill: var(--ginger);
    stroke: none;
    transform: rotate(-12deg) scale(1.15);
  }

  .learn-msg {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .learn-done,
  .learn.on .learn-todo {
    display: none;
  }

  .learn.on .learn-done {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-paw {
      transition: none;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }

  .pager-link {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
  }

  .pager-link:hover {
    border-color: var(--accent);
  }

  /* 正文里按类型分节 */
  .prose :global(.note-section) {
    margin: 28px 0;
  }

  .prose :global(h2) {
    margin: 0 0 10px;
    font-size: 22px;
    scroll-margin-top: 72px;
  }

  .prose :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .prose :global(.kind-danger),
  .prose :global(.kind-todo),
  .prose :global(.kind-questions),
  .prose :global(.kind-myths) {
    padding: 18px 20px;
    border-radius: var(--radius);
  }

  .prose :global(.kind-danger) {
    border: 1.5px solid color-mix(in srgb, var(--danger) 45%, transparent);
    background: var(--danger-soft);
  }

  .prose :global(.kind-danger h2) {
    color: var(--danger);
  }

  .prose :global(.kind-danger h2)::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--danger-fill);
    color: #fff;
    font-size: 15px;
    vertical-align: 2px;
  }

  .prose :global(.kind-todo) {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .prose :global(.kind-todo h2)::before {
    content: '🏠 ';
  }

  .prose :global(.kind-myths) {
    background: var(--warn-soft);
  }

  .prose :global(.kind-myths h2) {
    color: var(--warn);
  }

  .prose :global(.kind-myths li::marker) {
    content: '✗  ';
    color: var(--warn);
    font-weight: 700;
  }

  .prose :global(.kind-questions) {
    background: var(--calm-soft);
  }

  .prose :global(.kind-questions h2) {
    color: var(--calm);
  }


  .prose :global(.kind-local) {
    color: var(--ink-2);
  }

  .prose :global(details.note-section) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .prose :global(details.note-section > summary) {
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
  }

  .prose :global(details.note-section > summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(details.note-section > summary h2) {
    display: inline;
    margin: 0;
    font-size: 18px;
  }

  .prose :global(details.note-section > summary)::after {
    content: '展开';
    float: right;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
  }

  .prose :global(details.note-section[open] > summary)::after {
    content: '收起';
  }

  .prose :global(details.note-section > :not(summary)) {
    margin-left: 20px;
    margin-right: 20px;
  }

  .prose :global(details.note-section[open]) {
    padding-bottom: 8px;
  }

  .prose :global(.kind-sources li) {
    font-size: 15px;
  }
</style>
