---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../data/map';
import { sourcesOf } from '../../lib/sources';
import NoteWidget from '../../components/NoteWidget.astro';
import '../../styles/cats.css';
import '../../styles/tools.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const base = import.meta.env.BASE_URL;

const moduleIndex = MODULES.findIndex((m) => m.id === note.data.module);
const mod = MODULES[moduleIndex];

// 同一区域里已写好的笔记，按地图顺序排，用来做上一篇/下一篇
const written = new Set((await getCollection('notes')).map((n) => n.id));
const siblings = mod.topics.filter((t) => t.note && written.has(t.note));
const pos = siblings.findIndex((t) => t.note === note.id);
const prev = siblings[pos - 1];
const next = siblings[pos + 1];

const date = note.data.date.toISOString().slice(0, 10);
// 标题只在逗号、冒号后面换行，不把一个词拆到两行
const titleParts = note.data.title.split(/(?<=[，：、])/);
const reviewed = note.data.status === '已审核';
const sources = sourcesOf(note.body);
// 年龄滑块在三篇生命阶段笔记里，各自从这个阶段的典型年龄开始（单位：月）
const startAge = ({ kitten: 3, 'adult-cat': 48, 'senior-cat': 144 } as Record<string, number>)[note.id];

// 新格式的笔记开头是「记住这几件事」，已经是结论，就不再放「一句话结论」框
const remember = headings.some((h) => h.depth === 2 && /^记住/.test(h.text));
// 新格式的笔记里，「怎么测」那类小节后面有个插槽（见 rehype-note-sections），互动工具放在那里；旧笔记照旧放在正文前面
const [before, after] = (note.rendered?.html ?? '').split('<div class="try-slot"></div>');
const slotted = remember && after !== undefined;
---

<Base title={note.data.title} description={note.data.summary}>
  <article class="note wrap narrow">
    <nav class="crumbs" aria-label="位置">
      <a href={base}>地图</a>
      <span aria-hidden="true">/</span>
      <span>{String(moduleIndex + 1).padStart(2, '0')} {mod.name}</span>
    </nav>

    <h1 class="hand">
      {titleParts.slice(0, -1).map((t) => <span class="seg">{t}</span>)}
      <span class="seg">{titleParts.at(-1)}<span class="info">
        <button class="info-btn" type="button" aria-expanded="false" aria-controls="note-info" aria-label="审核状态和更新日期">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 11v6" /><circle class="dot" cx="12" cy="7.5" r="1.2" /></svg>
        </button>
        <span class="info-panel" id="note-info">
          <span class:list={['trust', { reviewed }]}>{reviewed ? '兽医审核过' : '还没经兽医审核'}</span>{!reviewed && '：内容整理自公开的兽医资料，还没请兽医看过。'}
          <a href={`${base}about/`}>内容从哪来</a>
          <span class="info-date">{date} 更新</span>
        </span>
      </span></span>
    </h1>
    {sources.length > 0 && <p class="meta">整理自 {sources.map((s) => s.short).join('、')}</p>}

    {note.data.scene && <p class="scene">{note.data.scene}</p>}

    {!remember && (
      <aside class="takeaway">
        <p class="takeaway-label">一句话结论</p>
        <p class="takeaway-text">{note.data.summary}</p>
      </aside>
    )}

    {!slotted && <NoteWidget widget={note.data.widget} base={base} startAge={startAge} />}

    {slotted ? (
      <>
        <div class="prose"><Fragment set:html={before} /></div>
        <NoteWidget widget={note.data.widget} base={base} startAge={startAge} />
        <div class="prose"><Fragment set:html={after} /></div>
      </>
    ) : (
      <div class="prose"><Content /></div>
    )}

    <section class="learn" data-note={note.id}>
      <button type="button" class="learn-btn" aria-pressed="false">
        <svg class="learn-paw" viewBox="-12 -12 24 24" aria-hidden="true">
          <ellipse cx="0" cy="4" rx="6.2" ry="5.2" /><circle cx="-6.6" cy="-3.6" r="2.7" /><circle cx="-2.3" cy="-8" r="2.7" /><circle cx="2.3" cy="-8" r="2.7" /><circle cx="6.6" cy="-3.6" r="2.7" />
        </svg>
        <span class="learn-label">我学会了这一篇</span>
      </button>
      <p class="learn-msg">
        <span class="learn-todo">点一下，首页三花猫的「{mod.name}」那块就会多上一点颜色。</span>
        <span class="learn-done">已记下。<a href={`${base}#${mod.id}`}>回地图看看你的三花猫</a>；再点一下按钮可以撤销。</span>
      </p>
    </section>

    <nav class="pager" aria-label="上一篇和下一篇">
      {prev ? (
        <a class="pager-link" href={`${base}notes/${prev.note}/`}>
          <span class="eyebrow">上一篇</span>
          <span>{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="pager-link next" href={`${base}notes/${next.note}/`}>
          <span class="eyebrow">下一篇</span>
          <span>{next.title}</span>
        </a>
      ) : (
        <a class="pager-link next" href={base}>
          <span class="eyebrow">回到地图</span>
          <span>看看下一块要点亮哪里</span>
        </a>
      )}
    </nav>
  </article>

  <script>
    import { loadLearned, setLearned } from '../../lib/learned';

    // 标题旁的小圆圈：点一下开、再点或点别处关
    const info = document.querySelector<HTMLElement>('.info')!;
    const infoBtn = info.querySelector<HTMLButtonElement>('.info-btn')!;
    function setInfo(open: boolean) {
      info.classList.toggle('open', open);
      infoBtn.setAttribute('aria-expanded', String(open));
      if (!open && info.contains(document.activeElement)) infoBtn.blur();
    }
    infoBtn.addEventListener('click', () => setInfo(!info.classList.contains('open')));
    document.addEventListener('click', (e) => {
      if (!info.contains(e.target as Node)) setInfo(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setInfo(false);
    });

    // 「我学会了这一篇」：记在这台设备的浏览器里，首页的三花猫按它填色
    const box = document.querySelector<HTMLElement>('.learn')!;
    const btn = box.querySelector<HTMLButtonElement>('.learn-btn')!;
    const note = box.dataset.note!;

    function show(on: boolean) {
      box.classList.toggle('on', on);
      btn.setAttribute('aria-pressed', String(on));
      btn.querySelector('.learn-label')!.textContent = on ? '已学会' : '我学会了这一篇';
    }

    show(loadLearned().has(note));
    btn.addEventListener('click', () => {
      const on = !loadLearned().has(note);
      if (setLearned(note, on)) show(on);
      else box.querySelector('.learn-msg')!.textContent = '这台设备的浏览器不允许保存（可能是无痕模式），学习进度记不下来。';
    });
  </script>
</Base>

<style>
  .note {
    padding-top: 28px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    position: relative;
    margin: 12px 0 10px;
    font-size: clamp(38px, 7vw, 56px);
  }

  h1 .seg {
    display: inline-block;
  }

  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  /* 标题旁的小圆圈：审核状态和日期收在里面，电脑上指上去、手机上点一下才显示 */
  .info-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    vertical-align: middle;
    cursor: pointer;
  }

  .info-btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .info-btn .dot {
    fill: currentColor;
    stroke: none;
  }

  .info-btn:hover,
  .info.open .info-btn {
    color: var(--ink);
  }

  .info-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 5;
    width: max-content;
    max-width: min(340px, 100%);
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: normal;
    line-height: 1.7;
    visibility: hidden;
    opacity: 0;
    /* 鼠标从圆圈挪到卡片上要经过一点空白，晚一点再收起来 */
    transition: opacity 0.15s, visibility 0s linear 0.3s;
  }

  .info.open .info-panel,
  .info:focus-within .info-panel {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.15s;
  }

  @media (hover: hover) {
    .info:hover .info-panel {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.15s;
    }
  }

  .info-panel a {
    margin-left: 4px;
  }

  .info-date {
    display: block;
    color: var(--muted);
  }

  .scene {
    margin: 24px 0 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.8;
  }

  .takeaway {
    margin: 24px 0;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .takeaway-label {
    margin: 0 0 4px;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .takeaway-text {
    margin: 0;
    font-size: 17px;
    line-height: 1.75;
  }

  .trust {
    color: var(--ink);
    font-weight: 600;
  }

  .trust.reviewed::before {
    content: '✓ ';
    color: var(--s-done);
  }

  .learn {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin: 40px 0 0;
    padding: 24px 20px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    text-align: center;
  }

  .learn-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 22px 8px 16px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
  }

  .learn-btn:hover {
    border-color: var(--pad);
  }

  .learn-paw {
    width: 30px;
    height: 30px;
    transform: rotate(-12deg);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    transition: transform 0.25s;
  }

  .learn.on .learn-btn {
    border-color: var(--ginger);
    background: color-mix(in srgb, var(--ginger) 18%, var(--surface));
    color: var(--ink);
  }

  .learn.on .learn-paw {
    fill: var(--ginger);
    stroke: none;
    transform: rotate(-12deg) scale(1.15);
  }

  .learn-msg {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .learn-done,
  .learn.on .learn-todo {
    display: none;
  }

  .learn.on .learn-done {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-paw {
      transition: none;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }

  .pager-link {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
  }

  .pager-link:hover {
    border-color: var(--pad);
  }

  /* 正文里按类型分节 */
  .prose :global(.note-section) {
    margin: 28px 0;
  }

  .prose :global(h2) {
    margin: 0 0 10px;
    font-size: 22px;
    scroll-margin-top: 72px;
  }

  .prose :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .prose :global(.kind-danger),
  .prose :global(.kind-todo),
  .prose :global(.kind-questions),
  .prose :global(.kind-myths) {
    padding: 18px 20px;
    border-radius: var(--radius);
  }

  .prose :global(.kind-danger) {
    border: 1.5px solid color-mix(in srgb, var(--danger) 45%, transparent);
    background: var(--danger-soft);
  }

  .prose :global(.kind-danger h2) {
    color: var(--danger);
  }

  .prose :global(.kind-danger h2)::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--danger-fill);
    color: #fff;
    font-size: 15px;
    vertical-align: 2px;
  }

  .prose :global(.kind-todo) {
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .prose :global(.kind-myths) {
    background: var(--surface-2);
  }

  .prose :global(.kind-myths li::marker) {
    content: '✗  ';
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(.kind-questions),
  .prose :global(.kind-askvet) {
    background: var(--calm-soft);
  }

  .prose :global(.kind-askvet) {
    padding: 18px 20px;
    border-radius: var(--radius);
  }

  .prose :global(.kind-askvet h2) {
    color: var(--calm);
  }

  .prose :global(.kind-questions h2) {
    color: var(--calm);
  }


  .prose :global(.kind-local) {
    color: var(--ink-2);
  }

  .prose :global(details.note-section) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .prose :global(details.note-section > summary) {
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
  }

  .prose :global(details.note-section > summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(details.note-section > summary h2) {
    display: inline;
    margin: 0;
    font-size: 18px;
  }

  .prose :global(details.note-section > summary)::after {
    content: '展开';
    float: right;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
  }

  .prose :global(details.note-section[open] > summary)::after {
    content: '收起';
  }

  .prose :global(details.note-section > :not(summary)) {
    margin-left: 20px;
    margin-right: 20px;
  }

  .prose :global(details.note-section[open]) {
    padding-bottom: 8px;
  }

  .prose :global(.kind-sources li) {
    font-size: 15px;
  }

  /* 记住这几件事：整篇最该带走的，编号做成大圆点 */
  .prose :global(.kind-remember) {
    padding: 20px 20px 8px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .prose :global(.kind-remember ol) {
    padding: 0;
    list-style: none;
    counter-reset: remember;
  }

  .prose :global(.kind-remember li) {
    position: relative;
    margin: 0 0 16px;
    padding-left: 44px;
    counter-increment: remember;
  }

  .prose :global(.kind-remember li)::before {
    content: counter(remember);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .prose :global(.kind-remember strong) {
    display: block;
    font-size: 18px;
  }

  /* 表格里加粗的数字放大，一眼能看到 */
  .prose :global(td strong) {
    font-size: 18px;
    white-space: nowrap;
  }

  /* 示意图 */
  .prose :global(.note-figure) {
    margin: 16px 0 20px;
  }

  .prose :global(.note-figure svg) {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto;
  }

  .prose :global(.note-figure figcaption) {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }

  /* 考考自己：点开才看答案 */
  .prose :global(.kind-quiz ol) {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .prose :global(.quiz-card) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .prose :global(.quiz-card > summary) {
    padding: 14px 16px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  .prose :global(.quiz-card > summary::-webkit-details-marker) {
    display: none;
  }

  .prose :global(.quiz-card > summary)::after {
    content: '看答案';
    display: block;
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
    text-underline-offset: 3px;
    font-weight: 400;
  }

  .prose :global(.quiz-card[open] > summary)::after {
    content: none;
  }

  .prose :global(.quiz-card > summary p) {
    display: inline;
    margin: 0;
  }

  .prose :global(.quiz-answer) {
    margin: 0 16px 14px;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--surface-2);
  }

  .prose :global(.quiz-answer p) {
    margin: 0;
  }
</style>
