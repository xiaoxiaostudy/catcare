---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { MODULES } from '../data/map';

const base = import.meta.env.BASE_URL;
const notes = new Map((await getCollection('notes')).map((n) => [n.id, n]));

// 读者视角：写好的笔记是「可以学」的，没写的主题显示「即将上线」。
// 学会了哪些存在读者自己的浏览器里（src/lib/learned.ts），页面加载后由下面的脚本填色。
const regions = MODULES.map((m) => {
  const topics = m.topics.map((t) => {
    const note = t.note ? notes.get(t.note) : undefined;
    return { ...t, note: note?.id, href: note ? `${base}notes/${note.id}/` : t.tool ? `${base}${t.tool}` : undefined };
  });
  const available = topics.filter((t) => t.note).length;
  return { ...m, topics, available };
});

const all = regions.flatMap((r) => r.topics);
const availableCount = all.filter((t) => t.note).length;
const firstNote = all.find((t) => t.note)!;
const currentId = regions.find((r) => r.available > 0)?.id ?? regions[0].id;

// 三花猫：七个区域是猫身上的七块花色。坐标都在 viewBox="-150 0 740 470" 里，
// 猫本身占 x 84–392；左右两边留给区域名。
// path 是花色形状（会被猫的轮廓裁掉），top/bottom 是花色在猫身上看得见的上下边，
// 学会了多少就从 bottom 往上填多少；a 是引线在花色上的起点，l 是名字的位置。
type Patch = { where: string; color: 'o' | 'k'; path: string; top: number; bottom: number; side: 'L' | 'R'; a: [number, number]; l: [number, number]; elbow?: [number, number] };
const CALICO: Record<string, Patch> = {
  recognize: { where: '头顶和左耳', color: 'o', path: 'M100 20 L205 20 C210 80 196 128 160 146 C128 160 104 140 100 20 Z', top: 34, bottom: 150, side: 'L', a: [140, 104], l: [52, 70] },
  prevention: { where: '右耳和右脸', color: 'k', path: 'M222 64 C252 30 310 24 312 90 C316 160 292 196 254 186 C228 170 222 120 222 64 Z', top: 34, bottom: 190, side: 'R', a: [262, 116], l: [408, 90] },
  nutrition: { where: '胸口', color: 'o', path: 'M118 214 C150 202 186 218 190 254 C192 292 160 312 126 302 C100 282 98 234 118 214 Z', top: 206, bottom: 306, side: 'L', a: [132, 252], l: [52, 236] },
  diseases: { where: '右边身子', color: 'k', path: 'M252 222 C300 212 330 282 320 342 C302 384 262 374 246 334 C234 294 230 244 252 222 Z', top: 214, bottom: 378, side: 'R', a: [284, 270], l: [408, 200] },
  behavior: { where: '左后腿', color: 'o', path: 'M92 318 C122 308 152 330 152 362 C150 398 120 414 92 404 Z', top: 312, bottom: 412, side: 'L', a: [112, 362], l: [52, 372] },
  'life-stages': { where: '右前爪', color: 'k', path: 'M200 412 A32 20 0 1 0 264 412 A32 20 0 1 0 200 412 Z', top: 398, bottom: 426, side: 'R', a: [244, 416], l: [408, 440], elbow: [300, 440] },
  'daily-care': { where: '尾巴', color: 'o', path: 'M330 250 L420 250 L420 440 L300 440 C340 390 372 330 330 250 Z', top: 262, bottom: 410, side: 'R', a: [380, 326], l: [408, 326] },
};
const calico = regions.map((r) => {
  const p = CALICO[r.id];
  const tipX = p.side === 'R' ? p.l[0] - 8 : p.l[0] + 8;
  const line = [p.a, ...(p.elbow ? [p.elbow] : []), [tipX, p.l[1]]].map((xy) => xy.join(',')).join(' ');
  return { ...r, p, line, fill: p.color === 'o' ? 'var(--calico-o)' : 'var(--calico-k)' };
});
---

<Base current="map">
  <section class="hero wrap">
    <p class="eyebrow">学习地图</p>
    <h1 class="serif">从认出急症开始，<br />一块一块点亮</h1>
    <p class="hero-sub">
      七个区域、{all.length} 个主题，就是这只三花猫身上的七块花色。每学会一篇，对应的那块就多上一点颜色。
    </p>

    <div class="overall">
      <span class="overall-bar" aria-hidden="true"><i id="learned-bar"></i></span>
      <span id="learned-text">共 {availableCount} 篇可以学，其余主题即将上线。</span>
    </div>
    <a class="next-up" id="next-up" href={firstNote.href}>
      <span class="next-label" id="next-label">从这里开始</span>
      <span class="next-title" id="next-title">{firstNote.title}</span>
      <span aria-hidden="true">→</span>
    </a>
    <p class="fine-print">学习进度只存在这台设备的浏览器里，不用注册。</p>

    <a class="sos-banner" href={`${base}emergency/`}>
      <span class="sos-dot" aria-hidden="true"></span>
      <span><strong>猫现在不对劲？</strong>打开急症清单，先判断要不要马上去医院</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="stage wrap">
    <div class="cat-box">
      <svg class="cat" viewBox="-150 0 740 470" role="group" aria-label="三花猫学习地图：点一块花色或旁边的名字，查看这个区域的主题">
        <defs>
          <clipPath id="cat-clip">
            <ellipse cx="200" cy="140" rx="92" ry="80" />
            <path d="M118 112 L126 34 L182 82 Z" /><path d="M282 112 L274 34 L218 82 Z" />
            <path d="M138 196 C96 250 84 350 104 410 Q200 428 296 410 C316 350 304 250 262 196 Z" />
            <ellipse cx="168" cy="412" rx="26" ry="14" /><ellipse cx="232" cy="412" rx="26" ry="14" />
            <path d="M292 408 C362 410 392 336 354 272 C346 260 330 264 336 280 C364 334 344 386 290 388 Z" />
          </clipPath>
          {calico.map((r) => <clipPath id={`cp-${r.id}`}><path d={r.p.path} /></clipPath>)}
        </defs>

        <g clip-path="url(#cat-clip)">
          <rect x="0" y="0" width="420" height="460" class="fur" />
          {calico.map((r) => (
            <g>
              <g clip-path={`url(#cp-${r.id})`}>
                <rect x="0" y="0" width="420" height="460" fill={r.fill} opacity={r.p.color === 'o' ? 0.16 : 0.12} />
                <rect x="0" y={r.p.bottom} width="420" height="460" fill={r.fill} class="fill" data-region={r.id} data-top={r.p.top} data-bottom={r.p.bottom} />
              </g>
              <path d={r.p.path} fill="none" stroke={r.fill} stroke-width="1.6" stroke-dasharray="4 4" opacity="0.55" />
            </g>
          ))}
        </g>

        <g class="lineart" fill="none" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
          <path d="M138 196 C96 250 84 350 104 410 Q200 428 296 410 C316 350 304 250 262 196" />
          <path d="M292 408 C362 410 392 336 354 272 C346 260 330 264 336 280 C364 334 344 386 290 388" />
          <path d="M122 98 L126 34 L178 62 M278 98 L274 34 L222 62" />
          <ellipse cx="200" cy="140" rx="92" ry="80" />
          <ellipse cx="168" cy="412" rx="26" ry="14" class="fur" /><ellipse cx="232" cy="412" rx="26" ry="14" />
          <path d="M172 290 C168 330 166 370 168 398 M228 290 C232 330 234 370 232 398" stroke-width="2" />
          <path d="M136 52 L140 82 M264 52 L260 82" stroke-width="1.6" opacity=".5" />
          <path d="M200 176 Q192 188 182 182 M200 176 Q208 188 218 182" stroke-width="2" />
          <path d="M150 168 L104 160 M150 176 L106 182 M250 168 L296 160 M250 176 L294 182" stroke-width="1.4" opacity=".7" />
        </g>
        {[166, 234].map((cx) => (
          <g>
            <ellipse cx={cx} cy="138" rx="12.5" ry="14.5" class="sclera" />
            <g class="pupil" data-cx={cx} data-cy="138">
              <ellipse cx={cx} cy="138" rx="8" ry="11" class="eye" />
              <circle cx={cx + 3} cy="133" r="2.8" class="fur" />
            </g>
          </g>
        ))}
        <path d="M191 164 L209 164 L200 175 Z" class="nose" />

        <g clip-path="url(#cat-clip)">
          {calico.map((r) => <path d={r.p.path} class="hit" data-region={r.id} aria-hidden="true" />)}
        </g>

        {calico.map((r) => (
          <a href={`#${r.id}`} class:list={['lbl', { on: r.id === currentId }]} data-region={r.id}>
            <rect class="bg" rx="10" />
            <polyline class="lead" points={r.line} />
            <circle class="anchor" cx={r.p.a[0]} cy={r.p.a[1]} r="5.5" fill={r.fill} />
            <text x={r.p.l[0]} y={r.p.l[1] + 8} text-anchor={r.p.side === 'R' ? 'start' : 'end'}>
              <tspan class="nm">{r.name}</tspan>
              <tspan class="ct" dx="8" data-count={r.id}>{r.available ? `0/${r.available}` : '即将上线'}</tspan>
            </text>
          </a>
        ))}
      </svg>
      <p class="hint">点猫身上的花色或旁边的名字，看这一块有哪些主题</p>
    </div>

    {calico.map((r) => (
      <article class="panel" id={r.id} data-region={r.id} data-available={r.available} hidden={r.id !== currentId}>
        <h2 class="serif">{r.name}<small data-count={r.id}>{r.available ? `已学会 0 / ${r.available} 篇` : '即将上线'}</small></h2>
        <p class="blurb">{r.blurb}</p>
        <p class="where">在猫身上：{r.p.where}</p>
        <ol class="paws">
          {r.topics.map((t) => {
            const Tag = t.href ? 'a' : 'span';
            return (
              <li class:list={{ soon: !t.note }} data-note={t.note}>
                <svg class="paw" viewBox="-12 -12 24 24" aria-hidden="true">
                  <ellipse cx="0" cy="4" rx="6.2" ry="5.2" /><circle cx="-6.6" cy="-3.6" r="2.7" /><circle cx="-2.3" cy="-8" r="2.7" /><circle cx="2.3" cy="-8" r="2.7" /><circle cx="6.6" cy="-3.6" r="2.7" />
                </svg>
                <span class="paw-text">
                  <Tag class="paw-title" href={t.href}>{t.title}</Tag>
                  <span class="stop-meta">
                    {t.note && <span class="pill learned">已学会</span>}
                    {!t.note && !t.tool && <span class="pill soon-pill">即将上线</span>}
                    {t.tool && !t.note && <span class="pill tool">互动工具</span>}
                    {t.tag && <span class="pill tag">{t.tag}</span>}
                  </span>
                </span>
              </li>
            );
          })}
        </ol>
      </article>
    ))}
  </section>

  <script>
    import { loadLearned } from '../lib/learned';

    // 点花色或名字：换右边（窄屏是下面）的主题列表，并把选中的区域写进网址 #id
    const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
    const labels = [...document.querySelectorAll<SVGAElement>('.lbl')];
    const hits = [...document.querySelectorAll<SVGPathElement>('.hit')];
    const narrow = matchMedia('(max-width: 760px)');

    function select(id: string, fromUser: boolean) {
      if (!panels.some((p) => p.dataset.region === id)) return;
      panels.forEach((p) => (p.hidden = p.dataset.region !== id));
      labels.forEach((l) => l.classList.toggle('on', l.dataset.region === id));
      hits.forEach((h) => h.classList.toggle('on', h.dataset.region === id));
      if (!fromUser) return;
      history.replaceState(null, '', `#${id}`);
      if (narrow.matches) document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // 名字后面的底色框要按文字实际宽度画
    function sizeLabels() {
      labels.forEach((l) => {
        const box = l.querySelector('text')!.getBBox();
        const bg = l.querySelector('.bg')!;
        bg.setAttribute('x', String(box.x - 10));
        bg.setAttribute('y', String(box.y - 6));
        bg.setAttribute('width', String(box.width + 20));
        bg.setAttribute('height', String(box.height + 12));
      });
    }

    labels.forEach((l) =>
      l.addEventListener('click', (e) => {
        e.preventDefault();
        select(l.dataset.region!, true);
      }),
    );
    hits.forEach((h) => h.addEventListener('click', () => select(h.dataset.region!, true)));
    narrow.addEventListener('change', sizeLabels);
    sizeLabels();

    // 猫的眼睛跟着鼠标（手机上是手指）看；指针离开页面就看回正前方
    const cat = document.querySelector<SVGSVGElement>('svg.cat')!;
    const pupils = [...cat.querySelectorAll<SVGGElement>('.pupil')];
    let frame = 0;
    function look(x?: number, y?: number) {
      const m = cat.getScreenCTM();
      const p = m && x !== undefined && y !== undefined ? new DOMPoint(x, y).matrixTransform(m.inverse()) : undefined;
      pupils.forEach((g) => {
        let tx = 0;
        let ty = 0;
        if (p) {
          const dx = p.x - Number(g.dataset.cx);
          const dy = p.y - Number(g.dataset.cy);
          const d = Math.hypot(dx, dy) || 1;
          const k = Math.min(d / 120, 1); // 指针离眼睛很近时只转一点
          tx = (dx / d) * 4 * k;
          ty = (dy / d) * 3.2 * k;
        }
        g.style.transform = `translate(${tx}px, ${ty}px)`;
      });
    }
    addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => look(e.clientX, e.clientY));
    });
    document.documentElement.addEventListener('pointerleave', () => look());
    addEventListener('blur', () => look());

    // 按读者学会的笔记给花色、计数、爪印和「下一篇」上色；从笔记页返回时也要重新算
    function applyProgress() {
      const learned = loadLearned();
      let total = 0;
      let done = 0;
      let next: HTMLLIElement | undefined;
      panels.forEach((panel) => {
        const id = panel.dataset.region!;
        const items = [...panel.querySelectorAll<HTMLLIElement>('li[data-note]')];
        const n = items.filter((li) => learned.has(li.dataset.note!)).length;
        const avail = items.length;
        total += avail;
        done += n;
        items.forEach((li) => li.classList.toggle('learned', learned.has(li.dataset.note!)));
        const first = items.find((li) => !learned.has(li.dataset.note!));
        items.forEach((li) => li.classList.toggle('next', li === first));
        next ??= first;
        const rect = cat.querySelector<SVGRectElement>(`.fill[data-region="${id}"]`)!;
        const top = Number(rect.dataset.top);
        const bottom = Number(rect.dataset.bottom);
        rect.setAttribute('y', String(avail ? bottom - (bottom - top) * (n / avail) : bottom));
        document.querySelectorAll(`[data-count="${id}"]`).forEach((el) => {
          if (!avail) return;
          el.textContent = el instanceof HTMLElement ? `已学会 ${n} / ${avail} 篇` : `${n}/${avail}`;
        });
      });

      const bar = document.getElementById('learned-bar')!;
      bar.style.width = `${total ? (done / total) * 100 : 0}%`;
      document.getElementById('learned-text')!.textContent =
        done === 0 ? `共 ${total} 篇可以学，其余主题即将上线。` : done === total ? `已上线的 ${total} 篇都学会了，新的主题写好会出现在这里。` : `你已学会 ${done} / ${total} 篇`;

      const link = document.getElementById('next-up') as HTMLAnchorElement;
      link.hidden = !next;
      if (next) {
        const a = next.querySelector<HTMLAnchorElement>('.paw-title')!;
        link.href = a.href;
        document.getElementById('next-label')!.textContent = done === 0 ? '从这里开始' : '下一篇';
        document.getElementById('next-title')!.textContent = a.textContent!;
      }
      return next?.closest<HTMLElement>('.panel')?.dataset.region;
    }

    const nextRegion = applyProgress();
    addEventListener('pageshow', (e) => e.persisted && applyProgress());
    addEventListener('storage', () => applyProgress());
    select(location.hash.slice(1) || nextRegion || (labels.find((l) => l.classList.contains('on'))?.dataset.region ?? ''), false);
  </script>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 8px;
  }

  .hero h1 {
    margin: 4px 0 12px;
    font-size: clamp(30px, 6vw, 44px);
    font-weight: 700;
  }

  .hero-sub {
    margin: 0 0 20px;
    color: var(--ink-2);
  }

  .overall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    color: var(--ink-2);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .overall-bar {
    flex: 1 1 200px;
    max-width: 420px;
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--s-todo);
  }

  .overall-bar i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 999px;
    background: var(--calico-o);
  }

  .next-up {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 16px;
    padding: 6px 14px;
    background: color-mix(in srgb, var(--calico-o) 22%, transparent);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(-1deg);
  }

  .next-up:hover .next-title {
    text-decoration: underline;
  }

  .next-label {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
  }

  .next-title {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
  }

  .fine-print {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .sos-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
    border-radius: var(--radius);
    background: var(--danger-soft);
    color: var(--ink);
    text-decoration: none;
  }

  .sos-banner strong {
    margin-right: 6px;
    color: var(--danger);
  }

  .sos-banner .arrow {
    margin-left: auto;
    color: var(--danger);
    font-size: 20px;
  }

  .sos-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--danger);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--danger) 20%, transparent);
  }

  /* 三花猫 */
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding-top: 24px;
    padding-bottom: 48px;
  }

  .hero,
  .stage {
    --calico-o: #d98a3d;
  }

  .cat-box {
    --fur: #fffaf2;
    --fur-line: #2b2520;
    --calico-o: #d98a3d;
    --calico-k: #3a312b;
    --nose: #e7a39a;
    --sclera: #ffffff;
    display: grid;
    gap: 10px;
  }

  @media (prefers-color-scheme: dark) {
    .cat-box {
      --fur: #efe6d8;
      --fur-line: #120f0d;
      --calico-k: #2a231e;
      --nose: #d98f86;
    }
  }

  .cat {
    width: 100%;
    max-width: 640px;
    justify-self: center;
    overflow: visible;
  }

  .fur {
    fill: var(--fur);
  }

  .lineart {
    stroke: var(--fur-line);
  }

  .sclera {
    fill: var(--sclera);
    stroke: var(--fur-line);
    stroke-width: 2;
  }

  .pupil {
    transition: transform 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .pupil {
      transition: none;
    }
  }

  .eye {
    fill: var(--fur-line);
  }

  .nose {
    fill: var(--nose);
  }

  .hit {
    fill: transparent;
    stroke: transparent;
    stroke-width: 6;
    cursor: pointer;
  }

  .hit:hover,
  .hit.on {
    stroke: var(--accent);
  }

  .hit:hover:not(.on) {
    stroke-width: 3;
    stroke-dasharray: 5 4;
  }

  .lbl {
    cursor: pointer;
    text-decoration: none;
    outline: none;
  }

  .lbl .bg {
    fill: transparent;
  }

  .lbl .lead {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.4;
  }

  .lbl .anchor {
    stroke: var(--fur);
    stroke-width: 2.5;
  }

  .lbl .nm {
    fill: var(--ink);
    font: 600 24px var(--sans);
  }

  .lbl .ct {
    fill: var(--muted);
    font: 400 20px var(--sans);
    font-variant-numeric: tabular-nums;
  }

  .lbl:hover .nm,
  .lbl:focus-visible .nm,
  .lbl.on .nm {
    fill: var(--accent);
  }

  .lbl:focus-visible .bg {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .lbl.on .bg {
    fill: var(--accent-soft);
  }

  .lbl.on .lead {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .hint {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  .panel {
    min-width: 0;
    padding: 20px 20px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scroll-margin-top: 72px;
  }

  .panel h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 4px;
    font-size: 24px;
  }

  .panel h2 small {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 400;
  }

  .blurb {
    margin: 0;
    color: var(--ink-2);
  }

  .where {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .paws {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

