---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { MODULES } from '../data/map';

const base = import.meta.env.BASE_URL;
const notes = new Map((await getCollection('notes')).map((n) => [n.id, n]));

// 读者视角：写好的笔记是「可以学」的，没写的主题显示「即将上线」。
// 学会了哪些存在读者自己的浏览器里（src/lib/learned.ts），页面加载后由下面的脚本填色。
const regions = MODULES.map((m) => {
  const topics = m.topics.map((t) => {
    const note = t.note ? notes.get(t.note) : undefined;
    return { ...t, note: note?.id, href: note ? `${base}notes/${note.id}/` : t.tool ? `${base}${t.tool}` : undefined };
  });
  const available = topics.filter((t) => t.note).length;
  return { ...m, topics, available };
});

const all = regions.flatMap((r) => r.topics);
const firstNote = all.find((t) => t.note)!;
const currentId = regions.find((r) => r.available > 0)?.id ?? regions[0].id;

// 三花猫：七个区域是猫身上的七块花色。坐标都在 viewBox="-175 0 800 480" 里，
// 猫本身占 x 84–392；左右两边留给手写的区域名。
// path 是花色形状（会被猫的轮廓裁掉），top/bottom 是花色在猫身上看得见的上下边，
// 学会了多少就从 bottom 往上填多少；a 是引线在花色上的起点，l 是名字的位置。
type Patch = { where: string; color: 'o' | 'k'; path: string; top: number; bottom: number; side: 'L' | 'R'; a: [number, number]; l: [number, number]; elbow?: [number, number] };
const CALICO: Record<string, Patch> = {
  recognize: { where: '头顶和左耳', color: 'o', path: 'M100 20 L205 20 C210 80 196 128 160 146 C128 160 104 140 100 20 Z', top: 34, bottom: 150, side: 'L', a: [140, 100], l: [52, 70] },
  prevention: { where: '右耳和右脸', color: 'k', path: 'M222 64 C252 30 310 24 312 90 C316 160 292 196 254 186 C228 170 222 120 222 64 Z', top: 34, bottom: 190, side: 'R', a: [262, 116], l: [408, 90] },
  nutrition: { where: '胸口', color: 'o', path: 'M110 250 C140 238 176 252 182 286 C186 318 158 334 124 326 C100 310 96 266 110 250 Z', top: 244, bottom: 330, side: 'L', a: [126, 262], l: [52, 222] },
  diseases: { where: '右边身子', color: 'k', path: 'M252 236 C300 226 330 292 320 348 C302 388 262 378 246 340 C234 300 230 256 252 236 Z', top: 230, bottom: 382, side: 'R', a: [284, 286], l: [408, 216] },
  behavior: { where: '左后腿', color: 'o', path: 'M92 340 C122 330 152 350 152 378 C150 404 120 416 92 408 Z', top: 336, bottom: 412, side: 'L', a: [112, 372], l: [52, 400] },
  'life-stages': { where: '右前爪', color: 'k', path: 'M200 412 A32 20 0 1 0 264 412 A32 20 0 1 0 200 412 Z', top: 398, bottom: 426, side: 'R', a: [244, 416], l: [408, 452], elbow: [300, 452] },
  'daily-care': { where: '尾巴', color: 'o', path: 'M330 250 L420 250 L420 440 L300 440 C340 390 372 330 330 250 Z', top: 262, bottom: 410, side: 'R', a: [380, 334], l: [408, 334] },
};
const calico = regions.map((r) => {
  const p = CALICO[r.id];
  const tipX = p.side === 'R' ? p.l[0] - 10 : p.l[0] + 10;
  const line = [p.a, ...(p.elbow ? [p.elbow] : []), [tipX, p.l[1]]].map((xy) => xy.join(',')).join(' ');
  return { ...r, p, line, fill: p.color === 'o' ? 'var(--ginger)' : 'var(--tortie)' };
});
---

<Base current="map">
  <section class="hero wrap">
    <div class="words">
      <h1 class="hand"><span>学养猫，</span><span>也给自家猫记一笔</span></h1>
      <p class="sub">七块花色是七个知识区域。每学会一篇，猫身上那块就多一点颜色。</p>
      <p class="basis">内容整理自 iCatCare、Cornell、AAFP、WSAVA、Merck 兽医手册等兽医机构的公开资料，每条都核对过原文。<a href={`${base}about/`}>内容从哪来</a></p>
    </div>

    <div class="next-box">
      <a class="next-link" id="next-up" href={firstNote.href}>
        <small id="next-label">从这里开始</small>
        <b id="next-title">{firstNote.title}</b>
      </a>
      <p class="progress" id="learned-text" hidden></p>
    </div>

    <div class="cat-box">
      <svg class="cat" viewBox="-175 0 800 480" role="group" aria-label="三花猫学习地图：点一块花色或旁边的名字，查看这个区域的主题">
        <defs>
          <clipPath id="cat-clip">
            <ellipse cx="200" cy="140" rx="92" ry="80" />
            <path d="M118 112 L126 34 L182 82 Z" /><path d="M282 112 L274 34 L218 82 Z" />
            <path d="M138 196 C96 250 84 350 104 410 Q200 428 296 410 C316 350 304 250 262 196 Z" />
            <ellipse cx="168" cy="412" rx="26" ry="14" /><ellipse cx="232" cy="412" rx="26" ry="14" />
            <path d="M292 408 C362 410 392 336 354 272 C346 260 330 264 336 280 C364 334 344 386 290 388 Z" />
          </clipPath>
          {calico.map((r) => <clipPath id={`cp-${r.id}`}><path d={r.p.path} /></clipPath>)}
        </defs>

        <g clip-path="url(#cat-clip)">
          <rect x="0" y="0" width="420" height="460" class="fur" />
          {calico.map((r) => (
            <g>
              <g clip-path={`url(#cp-${r.id})`}>
                <rect x="0" y="0" width="420" height="460" fill={r.fill} opacity={r.p.color === 'o' ? 0.14 : 0.09} />
                <rect x="0" y={r.p.bottom} width="420" height="460" fill={r.fill} class="fill" data-region={r.id} data-top={r.p.top} data-bottom={r.p.bottom} />
              </g>
              <path d={r.p.path} fill="none" stroke={r.fill} stroke-width="1.6" stroke-dasharray="4 4" opacity="0.5" />
            </g>
          ))}
        </g>

        <g class="lineart" fill="none" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round">
          <path d="M138 196 C96 250 84 350 104 410 Q200 428 296 410 C316 350 304 250 262 196" />
          <path d="M292 408 C362 410 392 336 354 272 C346 260 330 264 336 280 C364 334 344 386 290 388" />
          <path d="M122 98 L126 34 L178 62 M278 98 L274 34 L222 62" />
          <ellipse cx="200" cy="140" rx="92" ry="80" />
          <ellipse cx="168" cy="412" rx="26" ry="14" class="fur" /><ellipse cx="232" cy="412" rx="26" ry="14" />
          <path d="M172 290 C168 330 166 370 168 398 M228 290 C232 330 234 370 232 398" stroke-width="2" />
          <path d="M136 52 L140 82 M264 52 L260 82" stroke-width="1.6" opacity=".5" />
          <path d="M200 176 Q192 188 182 182 M200 176 Q208 188 218 182" stroke-width="2" />
          <path d="M150 168 L104 160 M150 176 L106 182 M250 168 L296 160 M250 176 L294 182" stroke-width="1.4" opacity=".7" />
        </g>
        {[166, 234].map((cx) => (
          <g>
            <ellipse cx={cx} cy="138" rx="12.5" ry="14.5" class="sclera" />
            <g class="pupil" data-cx={cx} data-cy="138">
              <ellipse cx={cx} cy="138" rx="8" ry="11" class="eye" />
              <circle cx={cx + 3} cy="133" r="2.8" fill="#fff" />
            </g>
          </g>
        ))}
        <path d="M191 164 L209 164 L200 175 Z" class="nose" />
        <path class="collar" d="M136 204 Q200 236 264 204" />

        <g clip-path="url(#cat-clip)">
          {calico.map((r) => <path d={r.p.path} class="hit" data-region={r.id} aria-hidden="true" />)}
        </g>

        {calico.map((r) => (
          <a href={`#${r.id}`} class:list={['lbl', { on: r.id === currentId, soon: !r.available }]} data-region={r.id} aria-label={r.name}>
            <rect class="bg" rx="4" />
            <polyline class="lead" points={r.line} />
            <circle class="anchor" cx={r.p.a[0]} cy={r.p.a[1]} r="5.5" fill={r.fill} />
            <text x={r.p.l[0]} y={r.p.l[1] + 10} text-anchor={r.p.side === 'R' ? 'start' : 'end'}>
              <tspan class="nm">{r.name}</tspan>
              {r.available > 0 && <tspan class="ct" dx="10" data-count={r.id}>0/{r.available}</tspan>}
            </text>
          </a>
        ))}

        <a class="tag-link" href={`${base}emergency/`} aria-label="猫不对劲？打开急症清单">
          <g class="tagnote">
            <polyline class="lead" points="186,246 120,300 62,300" />
            <text x="52" y="310" text-anchor="end">不对劲？点这里</text>
          </g>
          <g class="tag">
            <circle class="ring" cx="200" cy="222" r="5" />
            <circle cx="200" cy="244" r="17" />
            <path class="cross" d="M192 244 h16 M200 236 v16" />
          </g>
        </a>
      </svg>
    </div>
  </section>

  {calico.map((r) => (
    <section class="region wrap" id={r.id} data-region={r.id} hidden={r.id !== currentId}>
      <div class="region-head">
        <h2 class="hand">{r.name}</h2>
        <p class="count" data-count={r.id}>{r.available ? `学会了 0 / ${r.available} 篇` : '这一块还在写，即将上线'}</p>
        <p class="blurb">{r.blurb}</p>
        <p class="where">在猫身上是{r.p.where}</p>
      </div>
      <ol class="paws">
        {r.topics.map((t) => {
          const Tag = t.href ? 'a' : 'span';
          return (
            <li class:list={{ soon: !t.note }} data-note={t.note}>
              <svg class="paw" viewBox="-12 -12 24 24" aria-hidden="true">
                <ellipse cx="0" cy="4" rx="6.2" ry="5.2" /><circle cx="-6.6" cy="-3.6" r="2.7" /><circle cx="-2.3" cy="-8" r="2.7" /><circle cx="2.3" cy="-8" r="2.7" /><circle cx="6.6" cy="-3.6" r="2.7" />
              </svg>
              <span class="t">
                <Tag class="t-title" href={t.href}>{t.title}</Tag>
                <span class="t-note">
                  <span class="is-learned">学会了</span>
                  <span class="is-next">下一篇</span>
                  {!t.note && <span>{t.tool ? '先试试互动工具' : '即将上线'}</span>}
                  {t.tag && <span class="t-tag">{t.tag}</span>}
                </span>
              </span>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <script>
    import { loadLearned } from '../lib/learned';

    // 点花色或名字：换下面这一块的主题列表，并把选中的区域写进网址 #id
    const regions = [...document.querySelectorAll<HTMLElement>('section.region')];
    const labels = [...document.querySelectorAll<SVGAElement>('.lbl')];
    const hits = [...document.querySelectorAll<SVGPathElement>('.hit')];
    const cat = document.querySelector<SVGSVGElement>('svg.cat')!;
    const narrow = matchMedia('(max-width: 780px)');

    function select(id: string, fromUser: boolean) {
      if (!regions.some((r) => r.dataset.region === id)) return;
      regions.forEach((r) => (r.hidden = r.dataset.region !== id));
      labels.forEach((l) => l.classList.toggle('on', l.dataset.region === id));
      hits.forEach((h) => h.classList.toggle('on', h.dataset.region === id));
      if (!fromUser) return;
      history.replaceState(null, '', `#${id}`);
      if (narrow.matches) document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // 名字后面那条肉垫粉的底色，要按手写字实际的宽度画
    function sizeLabels() {
      labels.forEach((l) => {
        const box = l.querySelector('text')!.getBBox();
        const bg = l.querySelector('.bg')!;
        bg.setAttribute('x', String(box.x - 8));
        bg.setAttribute('y', String(box.y + 4));
        bg.setAttribute('width', String(box.width + 16));
        bg.setAttribute('height', String(Math.max(box.height - 4, 0)));
      });
    }

    labels.forEach((l) =>
      l.addEventListener('click', (e) => {
        e.preventDefault();
        select(l.dataset.region!, true);
      }),
    );
    hits.forEach((h) => h.addEventListener('click', () => select(h.dataset.region!, true)));
    narrow.addEventListener('change', sizeLabels);
    sizeLabels();
    document.fonts?.ready.then(sizeLabels);

    // 猫的眼睛跟着鼠标（手机上是手指）看；指针离开页面就看回正前方
    const pupils = [...cat.querySelectorAll<SVGGElement>('.pupil')];
    let frame = 0;
    function look(x?: number, y?: number) {
      const m = cat.getScreenCTM();
      const p = m && x !== undefined && y !== undefined ? new DOMPoint(x, y).matrixTransform(m.inverse()) : undefined;
      pupils.forEach((g) => {
        let tx = 0;
        let ty = 0;
        if (p) {
          const dx = p.x - Number(g.dataset.cx);
          const dy = p.y - Number(g.dataset.cy);
          const d = Math.hypot(dx, dy) || 1;
          const k = Math.min(d / 120, 1); // 指针离眼睛很近时只转一点
          tx = (dx / d) * 4 * k;
          ty = (dy / d) * 3.2 * k;
        }
        g.style.transform = `translate(${tx}px, ${ty}px)`;
      });
    }
    addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => look(e.clientX, e.clientY));
    });
    document.documentElement.addEventListener('pointerleave', () => look());
    addEventListener('blur', () => look());

    // 按读者学会的笔记给花色、计数、爪印和「下一篇」上色；从笔记页返回时也要重新算
    function applyProgress() {
      const learned = loadLearned();
      let total = 0;
      let done = 0;
      let next: HTMLLIElement | undefined;
      regions.forEach((region) => {
        const id = region.dataset.region!;
        const items = [...region.querySelectorAll<HTMLLIElement>('li[data-note]')];
        const n = items.filter((li) => learned.has(li.dataset.note!)).length;
        const avail = items.length;
        total += avail;
        done += n;
        const first = items.find((li) => !learned.has(li.dataset.note!));
        items.forEach((li) => {
          li.classList.toggle('learned', learned.has(li.dataset.note!));
          li.classList.toggle('next', li === first);
        });
        next ??= first;
        const rect = cat.querySelector<SVGRectElement>(`.fill[data-region="${id}"]`)!;
        const top = Number(rect.dataset.top);
        const bottom = Number(rect.dataset.bottom);
        rect.setAttribute('y', String(avail ? bottom - (bottom - top) * (n / avail) : bottom));
        document.querySelectorAll(`[data-count="${id}"]`).forEach((el) => {
          if (!avail) return;
          if (el instanceof HTMLElement) el.innerHTML = `学会了 <b>${n}</b> / ${avail} 篇`;
          else {
            el.textContent = `${n}/${avail}`;
            el.classList.toggle('some', n > 0);
          }
        });
      });

      // 还没学过的新访客不显示这一行
      const text = document.getElementById('learned-text')!;
      text.hidden = done === 0;
      text.innerHTML =
        done === total
            ? `写好的 ${total} 篇都学会了。新主题上线后会接着点亮。`
            : `你学会了 <b>${done}</b> 篇，共 ${total} 篇可以学。`;

      const link = document.getElementById('next-up') as HTMLAnchorElement;
      link.hidden = !next;
      if (next) {
        const a = next.querySelector<HTMLAnchorElement>('.t-title')!;
        link.href = a.href;
        document.getElementById('next-label')!.textContent = done === 0 ? '从这里开始' : '下一篇';
        document.getElementById('next-title')!.textContent = a.textContent!;
      }
      sizeLabels();
      return next?.closest<HTMLElement>('section.region')?.dataset.region;
    }

    const nextRegion = applyProgress();
    addEventListener('pageshow', (e) => e.persisted && applyProgress());
    addEventListener('storage', () => applyProgress());
    select(location.hash.slice(1) || nextRegion || (labels.find((l) => l.classList.contains('on'))?.dataset.region ?? ''), false);
  </script>
</Base>

<style>
  /* 首页：左边一句手写标题和「下一篇」，右边是主角三花猫；下面是选中区域的爪印小路。全部左对齐。 */
  .hero {
    --fur: #ffffff;
    --cat-line: #2c2a2e;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'words cat' 'next cat';
    column-gap: 24px;
    align-items: start;
    padding-top: 40px;
    padding-bottom: 8px;
  }

  @media (prefers-color-scheme: dark) {
    .hero {
      --fur: #f4f1ec;
    }
  }

  .words {
    grid-area: words;
    align-self: end;
  }

  .next-box {
    grid-area: next;
  }

  .cat-box {
    grid-area: cat;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 5.4vw, 66px);
    line-height: 1.02;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .sub {
    max-width: 22em;
    margin: 18px 0 0;
    color: var(--muted);
  }

  .basis {
    max-width: 26em;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .basis a {
    color: var(--ink-2);
  }

  .next-link {
    display: inline-grid;
    margin-top: 22px;
    padding: 8px 16px 10px;
    background: color-mix(in srgb, var(--pad) 60%, transparent);
    color: var(--on-pad);
    text-decoration: none;
    transform: rotate(-1.2deg);
  }

  @media (prefers-color-scheme: dark) {
    .next-link {
      background: var(--pad);
    }
  }

  .next-link small {
    font-size: 13px;
  }

  .next-link b {
    font-size: 18px;
    font-weight: 600;
  }

  .next-link:hover b {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .progress {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .progress :global(b) {
    color: var(--ginger);
    font-weight: 600;
  }

  /* 猫 */
  .cat {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .fur {
    fill: var(--fur);
  }

  .lineart {
    stroke: var(--cat-line);
  }

  .sclera {
    fill: #fff;
    stroke: var(--cat-line);
    stroke-width: 2;
  }

  .pupil {
    transition: transform 0.12s ease-out;
  }

  .eye {
    fill: var(--cat-line);
  }

  .nose {
    fill: var(--pad);
  }

  .hit {
    fill: transparent;
    stroke: transparent;
    stroke-width: 6;
    cursor: pointer;
  }

  .hit:hover,
  .hit.on {
    stroke: var(--pad);
  }

  .hit:hover:not(.on) {
    stroke-width: 4;
    stroke-dasharray: 6 5;
  }

  .lbl {
    cursor: pointer;
    text-decoration: none;
    outline: none;
  }

  .lbl .bg {
    fill: transparent;
  }

  .lbl.on .bg,
  .lbl:focus-visible .bg {
    fill: var(--pad);
    opacity: 0.6;
  }

  .lbl .lead {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.3;
  }

  .lbl.on .lead {
    stroke: var(--ink);
    stroke-width: 1.8;
  }

  .lbl .anchor {
    stroke: var(--fur);
    stroke-width: 2.5;
  }

  .lbl text,
  .tagnote text {
    font-family: var(--hand);
  }

  .lbl .nm {
    fill: var(--ink);
    font-size: 34px;
  }

  .lbl .ct {
    fill: var(--muted);
    font-size: 26px;
  }

  .lbl .ct.some {
    fill: var(--ginger);
  }

  .lbl.soon .nm {
    fill: var(--muted);
    opacity: 0.75;
  }

  .lbl.on .nm,
  .lbl.on .ct {
    fill: var(--on-pad);
    opacity: 1;
  }

  /* 红项圈和急救牌：急症入口 */
  .collar {
    fill: none;
    stroke: var(--danger-fill);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .tag circle {
    fill: var(--danger-fill);
  }

  .tag .ring {
    fill: none;
    stroke: var(--danger-fill);
    stroke-width: 2.5;
  }

  .tag .cross {
    stroke: #fff;
    stroke-width: 4;
    stroke-linecap: round;
  }

  .tag {
    transform-box: view-box;
    transform-origin: 200px 222px;
  }

  .tagnote text {
    fill: var(--danger);
    font-size: 30px;
  }

  .tagnote .lead {
    fill: none;
    stroke: var(--danger);
    stroke-width: 1.3;
  }

  .tag-link {
    outline: none;
  }

  .tag-link:hover .tag {
    animation: swing 0.7s ease-in-out;
  }

  .tag-link:focus-visible .ring {
    stroke-width: 5;
  }

  @keyframes swing {
    30% {
      transform: rotate(9deg);
    }
    65% {
      transform: rotate(-6deg);
    }
  }

  /* 选中的区域 */
  .region {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: 24px;
    margin-top: 20px;
    padding-top: 28px;
    padding-bottom: 32px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 64px;
  }

  .region h2 {
    margin: 0;
    font-size: 52px;
    line-height: 1.1;
  }

  .count {
    margin: 6px 0 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .count :global(b) {
    color: var(--ginger);
    font-weight: 600;
  }

  .blurb {
    max-width: 20em;
    margin: 10px 0 0;
  }

  .where {
