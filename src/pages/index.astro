---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { MODULES, STATUSES, type Status } from '../data/map';

const base = import.meta.env.BASE_URL;
const notes = new Map((await getCollection('notes')).map((n) => [n.id, n]));

const regions = MODULES.map((m) => {
  const topics = m.topics.map((t) => {
    const note = t.note ? notes.get(t.note) : undefined;
    const status: Status = note ? note.data.status : '未开始';
    return { ...t, status, href: note ? `${base}notes/${note.id}/` : t.tool ? `${base}${t.tool}` : undefined };
  });
  const written = topics.filter((t) => t.status !== '未开始').length;
  return { ...m, topics, written };
});

const all = regions.flatMap((r) => r.topics);
const counts = Object.fromEntries(STATUSES.map((s) => [s, all.filter((t) => t.status === s).length])) as Record<Status, number>;
const currentId = regions.find((r) => r.topics.some((t) => t.status !== '已审核'))?.id;

// 小路的形状：节点左右摆动，像一条蜿蜒的山路
const ROW = 68;
const SWAY = [0, 1, 2, 1, 0, 1, 2, 3, 2, 1];
const STEP = 26;
const nodeX = (i: number) => 22 + SWAY[i % SWAY.length] * STEP;
const nodeY = (i: number) => ROW / 2 + i * ROW;

function trailPath(n: number) {
  let d = `M ${nodeX(0)} ${nodeY(0)}`;
  for (let i = 1; i < n; i++) {
    const midY = (nodeY(i - 1) + nodeY(i)) / 2;
    d += ` C ${nodeX(i - 1)} ${midY}, ${nodeX(i)} ${midY}, ${nodeX(i)} ${nodeY(i)}`;
  }
  return d;
}
---

<Base current="map">
  <section class="hero wrap">
    <p class="eyebrow">学习地图</p>
    <h1 class="serif">从认出急症开始，<br />一块一块点亮</h1>
    <p class="hero-sub">
      七个区域、{all.length} 个主题。写好一篇点亮一块，经兽医审核后盖章。
    </p>

    <div class="overall" role="img" aria-label={`已写 ${all.length - counts['未开始']} 个，共 ${all.length} 个`}>
      {STATUSES.slice(1).toReversed().map((s) => (
        <span class="seg" data-status={s} style={`flex-grow:${counts[s]}`} />
      ))}
      <span class="seg" data-status="未开始" style={`flex-grow:${counts['未开始']}`} />
    </div>
    <ul class="legend">
      {STATUSES.map((s) => (
        <li>
          <span class="node mini" data-status={s} aria-hidden="true" />
          {s}
          <b>{counts[s]}</b>
        </li>
      ))}
    </ul>

    <a class="sos-banner" href={`${base}emergency/`}>
      <span class="sos-dot" aria-hidden="true"></span>
      <span><strong>猫现在不对劲？</strong>打开急症清单，先判断要不要马上去医院</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="regions wrap">
    {regions.map((r, ri) => (
      <details class="region" open={r.id === currentId} data-empty={r.written === 0 ? '' : undefined}>
        <summary>
          <span class="region-no serif">{String(ri + 1).padStart(2, '0')}</span>
          <span class="region-head">
            <span class="region-name">{r.name}</span>
            <span class="region-blurb">{r.blurb}</span>
            <span class="dots" aria-hidden="true">
              {r.topics.map((t) => <span class="dot" data-status={t.status} />)}
            </span>
          </span>
          <span class="region-count">
            <b>{r.written}</b>/{r.topics.length}
          </span>
        </summary>

        <ol class="trail" style={`height:${r.topics.length * ROW}px`}>
          <svg class="trail-line" width="140" height={r.topics.length * ROW} aria-hidden="true">
            <path d={trailPath(r.topics.length)} />
          </svg>
          {r.topics.map((t, i) => {
            const Tag = t.href ? 'a' : 'div';
            return (
              <li style={`top:${i * ROW}px;--x:${nodeX(i)}px`}>
                <Tag class="stop" href={t.href} data-status={t.status}>
                  <span class="node" data-status={t.status} aria-hidden="true" />
                  <span class="stop-text">
                    <span class="stop-title">{t.title}</span>
                    <span class="stop-meta">
                      {t.status !== '未开始' && <span class="pill status" data-status={t.status}>{t.status}</span>}
                      {t.tool && !t.note && <span class="pill tool">互动工具</span>}
                      {t.tag && <span class="pill tag">{t.tag}</span>}
                    </span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ol>
      </details>
    ))}
  </section>
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 8px;
  }

  .hero h1 {
    margin: 4px 0 12px;
    font-size: clamp(30px, 6vw, 44px);
    font-weight: 700;
  }

  .hero-sub {
    margin: 0 0 20px;
    color: var(--ink-2);
  }

  .overall {
    display: flex;
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--s-todo);
  }

  .seg[data-status='写作中'] {
    background: var(--s-draft);
  }
  .seg[data-status='已完成'] {
    background: var(--s-done);
  }
  .seg[data-status='已审核'] {
    background: var(--s-reviewed);
  }
  .seg[data-status='未开始'] {
    background: var(--s-todo);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 14px;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend b {
    color: var(--ink);
  }

  .sos-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 14px 16px;
    border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);
    border-radius: var(--radius);
    background: var(--danger-soft);
    color: var(--ink);
    text-decoration: none;
  }

  .sos-banner strong {
    margin-right: 6px;
    color: var(--danger);
  }

  .sos-banner .arrow {
    margin-left: auto;
    color: var(--danger);
    font-size: 20px;
  }

  .sos-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--danger);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--danger) 20%, transparent);
  }

  /* 区域 */
  .regions {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }

  .region {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .region[data-empty]:not([open]) {
    box-shadow: none;
    background: transparent;
  }

  .region summary {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    cursor: pointer;
    list-style: none;
  }

  .region summary::-webkit-details-marker {
    display: none;
  }

  .region-no {
    flex: none;
    width: 40px;
    color: var(--accent);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
  }

  .region[data-empty] .region-no {
    color: var(--muted);
  }

  .region-head {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .region-name {
    font-size: 18px;
    font-weight: 650;
  }

  .region-blurb {
    color: var(--muted);
    font-size: 14px;
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--s-todo);
  }

  .dot[data-status='写作中'] {
    background: var(--s-draft);
  }
  .dot[data-status='已完成'] {
    background: var(--s-done);
  }
  .dot[data-status='已审核'] {
    background: var(--s-reviewed);
  }

  .region-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 14px;
    white-space: nowrap;
  }

  .region-count b {
    color: var(--ink);
    font-size: 18px;
  }

  /* 蜿蜒的小路 */
  .trail {
    position: relative;
    margin: 0 16px 16px;
    padding: 0;
    list-style: none;
  }

  .trail-line {
    position: absolute;
    top: 0;
    left: 0;
  }

  .trail-line path {
    fill: none;
    stroke: var(--line);
    stroke-width: 3;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
  }

  .trail li {
    position: absolute;
    left: 0;
    right: 0;
    height: 68px;
  }

  .stop {
    position: absolute;
    top: 50%;
    left: calc(var(--x) - 15px);
    right: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateY(-50%);
    color: var(--muted);
    text-decoration: none;
  }

  a.stop {
    color: var(--ink);
  }

  a.stop:hover .stop-title {
    color: var(--accent);
    text-decoration: underline;
  }

  .stop-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stop-title {
    font-size: 15px;
    line-height: 1.4;
  }

  a.stop .stop-title {
    font-weight: 600;
  }

  .stop-meta {
    display: flex;
    gap: 6px;
  }

  .stop-meta:empty {
    display: none;
  }

  .tool {
    background: var(--calm-soft);
    color: var(--calm);
  }

  .tag {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* 节点 */
  .node {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border: 2px dashed var(--s-todo);
    border-radius: 50%;
    background: var(--surface);
  }

  .node.mini {
    width: 14px;
    height: 14px;
  }

  .node[data-status='写作中'] {
    border: 2px solid var(--s-draft);
    background: conic-gradient(var(--s-draft) 0 50%, var(--surface) 50% 100%);
  }

  .node[data-status='已完成'] {
    border: 2px solid var(--s-done);
    background: var(--s-done);
  }

  .node[data-status='已审核'] {
    border: 2px solid var(--s-reviewed);
    background: var(--s-reviewed);
  }

  .node:not(.mini)[data-status='已完成']::after,
  .node:not(.mini)[data-status='已审核']::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
  }

  .node:not(.mini)[data-status='已审核']::before {
    content: '兽医';
    position: absolute;
    top: -8px;
    right: -14px;
    padding: 0 3px;
    border: 1.5px solid var(--s-reviewed);
    border-radius: 4px;
    background: var(--surface);
    color: var(--s-reviewed);
    font-size: 9px;
    font-weight: 700;
    line-height: 1.3;
    transform: rotate(12deg);
  }
</style>
