---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { WORRIES } from '../data/worries';
import { SITUATIONS, TIERS } from '../data/emergency';

const base = import.meta.env.BASE_URL;
const titles = new Map((await getCollection('notes')).map((n) => [n.id, n.data.title]));
const sos = new Map(SITUATIONS.map((s) => [s.id, s]));
---

<Base title="我家猫……" description="按你担心的情况找笔记：吐了、乱尿、舔秃了、刚接回小猫……">
  <div class="wrap narrow worries">
    <h1 class="hand">我家猫……</h1>
    <p class="lead">找一条最像的，点进对应的笔记。要马上去医院的情况，先看<a href={`${base}emergency/`}>急症清单</a>。</p>

    <nav class="jump" aria-label="跳到">
      {WORRIES.map((g, i) => <a href={`#g${i + 1}`}>{g.name}</a>)}
    </nav>

    {WORRIES.map((g, i) => (
      <section class="group" id={`g${i + 1}`}>
        <h2 class="hand">{g.name}</h2>
        <ul>
          {g.items.map((w) => {
            const s = w.emergency ? sos.get(w.emergency) : undefined;
            // 要马上去医院的，提示放在笔记前面、用急症红；其他档放在后面
            const hint = s && (
              <a class="sos-hint" data-tier={s.tier} href={`${base}emergency/#${s.id}`}>
                <span><b>{TIERS[s.tier].label}</b>：{s.title}</span>
              </a>
            );
            return (
              <li>
                <p class="worry">{w.text}</p>
                {s?.tier === 'now' && hint}
                <p class="reads">
                  {w.notes.map((n) => (
                    <a href={`${base}notes/${n}/`}>{titles.get(n)}</a>
                  ))}
                </p>
                {s && s.tier !== 'now' && hint}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .worries {
    padding-top: 28px;
  }

  h1 {
    margin: 6px 0 8px;
    font-size: clamp(38px, 7vw, 56px);
  }

  .lead {
    margin: 0;
    color: var(--ink-2);
  }

  /* 一页 26 条，手机上很长：顶上三组可以直接跳 */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .jump a {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--pad);
    color: var(--ink);
  }

  .group {
    margin-top: 36px;
    scroll-margin-top: 72px;
  }

  h2 {
    margin: 0 0 4px;
    font-size: 30px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .worry {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }

  /* 几篇笔记各自带下划线，用空隙隔开；不用「·」，换行时不会落到行首 */
  .reads {
    display: flex;
    flex-wrap: wrap;
    column-gap: 18px;
    margin: 0;
    font-size: 15px;
  }

  /* 手机上手指点得到：每个链接上下多留一点 */
  .reads a {
    display: inline-block;
    padding: 6px 0;
  }

  /* 急症清单里也有的情况：用那一档的颜色点一下 */
  .sos-hint {
    --c: var(--calm);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .sos-hint b {
    font-weight: 600;
  }

  /* 立刻去医院：紧跟在情况下面，红字加粗，慌的时候第一眼就看到 */
  .sos-hint[data-tier='now'] {
    margin: 4px 0 2px;
    color: var(--danger);
    font-size: 15px;
    font-weight: 600;
    text-decoration-color: color-mix(in srgb, var(--danger) 40%, transparent);
  }

  .sos-hint[data-tier='now'] b {
    font-weight: 700;
  }

  .sos-hint::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    transform: translateY(-1px);
  }

  .sos-hint:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--c);
  }

  .sos-hint[data-tier='now'] {
    --c: var(--danger);
  }

  .sos-hint[data-tier='now']:hover {
    color: var(--danger);
  }

  .sos-hint[data-tier='soon'] {
    --c: var(--warn);
  }
</style>
